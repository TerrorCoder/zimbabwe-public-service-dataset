{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zimbabwe Public Service Knowledge Dataset Record Schema",
  "description": "Standardized schema for Zimbabwean public service administrative procedures and benchmark data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "service",
    "agency",
    "agency_code",
    "category",
    "requirements",
    "fees",
    "steps",
    "processing_time",
    "source_url",
    "provenance",
    "multilingual_intents",
    "ai_task_tags",
    "last_verified"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^SVC-[0-9]{3,5}$",
      "description": "Unique record identifier, e.g., SVC-001"
    },
    "service": {
      "type": "string",
      "description": "Primary service title in English"
    },
    "agency": {
      "type": "string",
      "description": "Full official name of the administrative government agency"
    },
    "agency_code": {
      "type": "string",
      "description": "Short code for the agency (e.g., CIVREG, DCIP, ZIMRA, PRAZ, MICTPCS, POTRAZ)"
    },
    "category": {
      "type": "string",
      "enum": [
        "civil_registration",
        "business_registration",
        "intellectual_property",
        "tax",
        "procurement",
        "postal_licensing",
        "transport_licensing",
        "social_security"
      ],
      "description": "Controlled vocabulary category of the public service"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of prerequisite documents, forms, or conditions required"
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "amount_usd"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Fee schedule breakdown in USD (or ZiG equivalent note)"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered sequence of steps to complete the procedure"
    },
    "processing_time": {
      "type": "string",
      "description": "Estimated turnaround or processing timeframe"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Official URL from which the administrative details were extracted"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "collection_method",
        "collection_time"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "collection_method": {
          "type": "string",
          "enum": ["web_extraction", "in_person_verification", "phone_verification"]
        },
        "collection_time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Audit trail metadata describing data origin and collection timestamp"
    },
    "multilingual_intents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "sn",
        "nd"
      ],
      "properties": {
        "en": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sn": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nd": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "description": "Natural language question/intent variations across English, Shona, and Ndebele"
    },
    "ai_task_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Applicable AI benchmark task tags (e.g., retrieval, qa, classification)"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date string (YYYY-MM-DD) indicating last verified date"
    }
  }
}
