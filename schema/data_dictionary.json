{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zimbabwe Public Service Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "service",
    "agency",
    "agency_code",
    "category",
    "requirements",
    "fees",
    "steps",
    "processing_time",
    "source_url",
    "last_verified"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^SVC-\\d{3}$"
    },
    "service": {
      "type": "string"
    },
    "agency": {
      "type": "string"
    },
    "agency_code": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "civil_registration",
        "business_registration",
        "intellectual_property",
        "tax",
        "procurement",
        "postal_licensing"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "amount_usd"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "amount_usd": {
            "type": "number"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processing_time": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    }
  }
}
